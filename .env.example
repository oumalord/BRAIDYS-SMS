DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
PORT=8787

# Optional real email delivery for booking and queue notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@your-domain.example

# Optional real Safaricom Daraja STK Push
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/api/mpesa/callback

# M-Pesa B2C payroll transfers
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_QUEUE_TIMEOUT_URL=https://your-public-domain.example/api/payroll/timeout
MPESA_B2C_RESULT_URL=https://your-public-domain.example/api/payroll/result
MPESA_B2C_SHORTCODE=
